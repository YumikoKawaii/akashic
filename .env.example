# ── Database ──────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=akashic
DB_PASSWORD=your-db-password
DB_NAME=postgres
DB_SCHEMA=akashic
DB_SSLMODE=disable

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Server ────────────────────────────────────────────────────
SERVER_PORT=8080
# Directory the Go server serves the built SPA from (index.html + /assets).
STATIC_DIR=./static

# ── Google OAuth (client-initiated, Connect RPC) ──────────────
# Register at console.cloud.google.com.
# GOOGLE_CALLBACK_URL is the FRONTEND callback page — not a backend route.
# It must EXACTLY match an Authorized redirect URI on the OAuth client, and
# match the redirect_uri the SPA sends during code exchange (origin + /auth/callback).
#   dev:  http://localhost:5173/auth/callback
#   prod: https://yourdomain.com/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/callback

# ── JWT ───────────────────────────────────────────────────────
# Bearer token issued to the SPA and stored in localStorage.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
